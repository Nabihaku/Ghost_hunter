# Copy this file to .env and paste your key from https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_ENTERPRISE=0
GOOGLE_API_KEY=paste-your-key-here
# Optional: change the model if this one is not available to you (e.g. gemini-2.5-flash)
GHOST_MODEL=gemini-3.5-flash
# Set to 0 if the ADK confirmation pop-up causes problems (typed approval phrase still protects execution)
GHOST_CONFIRM_POPUP=1
